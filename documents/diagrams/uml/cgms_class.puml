@startuml cgms_class
skinparam classAttributeIconSize 0

title CGMS – Software Class Diagram (Typed Signals)

' --------------------
' Data Types
' --------------------
class RawSensorSample {
  +adcCounts: int
  +temperatureC: float
  +timestamp: uint32
}

class ConditionedSignal {
  +normalizedValue: float
  +temperatureCompensated: bool
}

enum Trend {
  RapidRise
  Rise
  Stable
  Fall
  RapidFall
}

class GlucoseEstimate {
  +mgDl: float
  +trend: Trend
  +valid: bool
}

' --------------------
' Processing Components
' --------------------
class GlucoseSensor {
  +readRaw(): RawSensorSample
}

class SignalProcessor {
  +filter(sample: RawSensorSample): ConditionedSignal
}

class GlucoseEstimator {
  +compute(signal: ConditionedSignal): GlucoseEstimate
}

class AlertManager {
  +checkThresholds(estimate: GlucoseEstimate)
}

class BLEService {
  +notify(estimate: GlucoseEstimate)
}

GlucoseSensor --> SignalProcessor
SignalProcessor --> GlucoseEstimator
GlucoseEstimator --> AlertManager
GlucoseEstimator --> BLEService

@enduml
